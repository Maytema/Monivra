<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Touch signals (a wrong PIN, a refused file); a normal permission, no dialog. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <application>
    <!-- Lets the camera application write a photo into this application's cache. -->
    <provider
      android:name="expo.modules.monivranative.MonivraPhotoProvider"
      android:authorities="${applicationId}.monivra.photos"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/monivra_photo_paths" />
    </provider>
  </application>
  <queries>
    <intent>
      <action android:name="android.media.action.IMAGE_CAPTURE" />
    </intent>
  </queries>
</manifest>
