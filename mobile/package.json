{
  "name": "monivra-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "description": "Monivra on React Native + Expo. The first application (repository root) stays the reference until this one passes acceptance.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.core.json",
    "boundaries": "node scripts/check-boundaries.mjs",
    "parity:record": "node test/parity/run-old.mjs",
    "i18n": "node scripts/convert-strings.mjs"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-background-task": "~58.0.13",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
